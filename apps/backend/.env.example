# ==========================================
# Backend Environment Variables
# ==========================================
# Copy to apps/backend/.env
# ==========================================

# ===== DATABASE (from Neon) =====
DATABASE_URL="postgresql://username:password@host.neon.tech/database?sslmode=require&connection_limit=10"
DIRECT_URL="postgresql://username:password@host.neon.tech/database?sslmode=require"

# ===== AUTHENTICATION =====
JWT_SECRET="your-64-character-secret-here"
JWT_EXPIRATION="24h"

# ===== SERVER =====
NODE_ENV="production"
PORT=3001
HOST="0.0.0.0"

# ===== CORS =====
CORS_ORIGIN="https://your-project.vercel.app"

# ===== GRAPHQL =====
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false

# ===== LOGGING =====
LOG_LEVEL="info"

# ===== RATE LIMITING =====
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
